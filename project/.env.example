# Token ใช้ได้ 1 ตัวก็พอ (ลำดับความสำคัญ: DISCORD_TOKEN > DISCORD_BOT_TOKEN > BOT_TOKEN)
DISCORD_TOKEN=your_discord_token_here
# DISCORD_BOT_TOKEN=
# BOT_TOKEN=

# development | staging | production
APP_ENV=development

# true/false เปิด sync slash command อัตโนมัติ
AUTO_SYNC_COMMANDS=true

# path โฟลเดอร์เก็บ assignments.json และ users.json
BOT_DATA_DIR=./
